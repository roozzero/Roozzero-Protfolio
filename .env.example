# Roozzero Academy Server Environment Configuration
PORT=3000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=roozzero_academy

# Administrator Credentials (configured in server environment)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Application URL
APP_URL=http://localhost:3000

# Optional Google OAuth (leave empty to use local password authentication)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
